# English Nova local environment template.
# Copy this file to .env and replace any placeholder secrets before running.

# Frontend and gateway ports
FRONTEND_PORT=3000
GATEWAY_SERVICE_PORT=8080
GATEWAY_CONTAINER_PORT=8080
GATEWAY_HOST_PORT=8087

# Backend service ports
AUTH_SERVICE_PORT=8085
SYSTEM_SERVICE_PORT=8081
STUDY_SERVICE_PORT=8082
SEARCH_SERVICE_PORT=8083
IMPORT_SERVICE_PORT=8084
QUIZ_SERVICE_PORT=8086

# Nacos
NACOS_PORT=8848
NACOS_CONSOLE_PORT=8080
NACOS_GRPC_PORT=9848
NACOS_NAMESPACE=public
NACOS_GROUP=DEFAULT_GROUP
NACOS_AUTH_ENABLE=true
NACOS_AUTH_ADMIN_ENABLE=true
NACOS_AUTH_CONSOLE_ENABLE=true
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
NACOS_AUTH_TOKEN=replace-with-base64-token-at-least-32-bytes
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=security

# MySQL
MYSQL_PORT=4407
MYSQL_DATABASE=english_nova
MYSQL_USERNAME=english_nova
MYSQL_PASSWORD=english_nova
MYSQL_ROOT_PASSWORD=root

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# Authentication and gateway internal signing
JWT_SECRET=replace-with-local-jwt-secret-at-least-32-chars
JWT_EXPIRATION_HOURS=72
INTERNAL_AUTH_SECRET=replace-with-internal-auth-secret
INTERNAL_AUTH_MAX_SKEW_SECONDS=60
AUTH_BCRYPT_STRENGTH=10

# Import and indexing queue names
ENGLISH_NOVA_IMPORT_EXCHANGE=english-nova.import
ENGLISH_NOVA_IMPORT_QUEUE=english-nova.import.queue
ENGLISH_NOVA_IMPORT_ROUTING_KEY=english.nova.import.requested
ENGLISH_NOVA_SEARCH_INDEX_QUEUE=english-nova.search.index.queue
ENGLISH_NOVA_INDEXED_ROUTING_KEY=english.nova.wordbook.imported

# Public catalog import
ENGLISH_NOVA_SEARCH_PUBLIC_CATALOG_EXTERNAL_DIR=.local/public-catalog
ENGLISH_NOVA_SEARCH_REBUILD_ON_STARTUP=true

# AI provider. OpenAI is used first; DeepSeek values are fallback-compatible.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-api-key
OPENAI_MODEL=gpt-4.1-mini
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash

# Search enrichment and example audio
ENGLISH_NOVA_ENRICHMENT_TTS_MODEL=gpt-4o-mini-tts
ENGLISH_NOVA_ENRICHMENT_TTS_VOICE=cedar
ENGLISH_NOVA_ENRICHMENT_BATCH_SIZE=30
ENGLISH_NOVA_ENRICHMENT_WORKER_CONCURRENCY=12
ENGLISH_NOVA_ENRICHMENT_TTS_CONCURRENCY=6
ENGLISH_NOVA_ENRICHMENT_MAX_RETRIES=3
ENGLISH_NOVA_ENRICHMENT_WORKER_DELAY_MS=1000
ENGLISH_NOVA_ENRICHMENT_BACKFILL_DELAY_MS=10000
ENGLISH_NOVA_ENRICHMENT_PUBLIC_LIMIT=35000
ENGLISH_NOVA_ENRICHMENT_CHAT_MAX_TURNS=5
ENGLISH_NOVA_ENRICHMENT_CHAT_TIMEOUT_SECONDS=60
ENGLISH_NOVA_ENRICHMENT_CHAT_MAX_OUTPUT_CHARS=1800
ENGLISH_NOVA_ENRICHMENT_EXAMPLE_AUDIO_ENABLED=false
ENGLISH_NOVA_ENRICHMENT_EXAMPLE_AUDIO_DIR=upload/example-audio
ENGLISH_NOVA_ENRICHMENT_TEXT_ONLY_MODE=false
ENGLISH_NOVA_ENRICHMENT_AUDIO_ONLY_MODE=false
ENGLISH_NOVA_ENRICHMENT_AUDIO_SCOPE_FIELD=created_at
ENGLISH_NOVA_ENRICHMENT_AUDIO_SCOPE_ORDER=asc
ENGLISH_NOVA_ENRICHMENT_AUDIO_SCOPE_LIMIT=50000
